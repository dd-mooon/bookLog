# Docker Compose / 클라우드 배포용 환경 변수
# 사용: cp .env.docker.example .env 후 값 수정

# 서버 공인 IP 또는 도메인 (예: 123.45.67.89)
PUBLIC_HOST=your-server-ip

# Frontend 빌드 시 API URL이 포함됩니다 (브라우저에서 접근 가능한 주소)
NEXT_PUBLIC_API_BASE_URL=http://your-server-ip:4000/api

# 이메일 인증 링크 등에 사용
FRONTEND_URL=http://your-server-ip:3000

# 프로덕션 JWT 시크릿 (32자 이상 랜덤 문자열 권장)
JWT_SECRET=change-this-to-a-long-random-string

# SMTP (미설정 시 콘솔에 인증 링크 출력)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@booklog.com
